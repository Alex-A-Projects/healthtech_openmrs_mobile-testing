{
  "name": "healthtech-openmrs-mobile-testing",
  "version": "1.0.0",
  "description": "Mobile end-to-end test suite for OpenMRS O2 (web app rendered in mobile browsers) via WebdriverIO + Appium on iPhone 17 Pro (iOS 26) and Samsung Galaxy S25 (Android 15).",
  "private": true,
  "type": "module",
  "scripts": {
    "test:android": "wdio run wdio.android.conf.ts",
    "test:ios": "wdio run wdio.ios.conf.ts",
    "test:both": "npm run test:android && npm run test:ios",
    "test": "npm run test:both",
    "lint": "tsc --noEmit",
    "start:openmrs": "docker compose up -d && ./scripts/wait-for-openmrs.sh",
    "stop:openmrs": "docker compose down",
    "logs:openmrs": "docker compose logs -f openmrs",
    "reset:openmrs": "docker compose down -v && npm run start:openmrs"
  },
  "dependencies": {
    "@wdio/allure-reporter": "^9.0.0",
    "@wdio/appium-service": "^9.0.0",
    "@wdio/cli": "^9.0.0",
    "@wdio/local-runner": "^9.31.9",
    "@wdio/mocha-framework": "^9.0.0",
    "@wdio/spec-reporter": "^9.0.0",
    "@wdio/types": "^9.0.0",
    "appium": "^2.11.0",
    "appium-uiautomator2-driver": "^4.0.0",
    "appium-xcuitest-driver": "^7.0.0",
    "dotenv": "^16.4.5",
    "expect-webdriverio": "^4.0.0",
    "webdriverio": "^9.0.0"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.0",
    "@types/node": "^20.11.0",
    "ts-node": "^10.9.0",
    "typescript": "^5.4.0"
  },
  "engines": {
    "node": ">=20"
  }
}
