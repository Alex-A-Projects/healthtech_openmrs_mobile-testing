# OpenMRS O2 demo / local Docker
O2_BASE_URL=https://o2.openmrs.org/openmrs
# O2_BASE_URL=http://localhost:8088/openmrs   # local Docker
O2_USERNAME=admin
O2_PASSWORD=Admin123
O2_LOCATION=Inpatient Ward

# Appium
APPIUM_HOST=localhost
APPIUM_PORT=4723

# Device overrides
IOS_DEVICE=iPhone 17 Pro
IOS_VERSION=26.0
ANDROID_DEVICE=Samsung Galaxy S25
ANDROID_OS=15

# Tuning
ACTION_DELAY_MS=150
LOG_LEVEL=info

# Cloudflare bypass (only needed when O2_BASE_URL points at the public demo)
CF_CLEARANCE=
CF_BM=

# Skip the O2 health probe in CI for faster startup
SKIP_GLOBAL_SETUP=false
